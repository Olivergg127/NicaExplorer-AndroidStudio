rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'ADMIN';
    }

    function isAuditor() {
      return signedIn()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'AUDITOR';
    }

    function role() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol;
    }

    // Cuenta con permiso para administrar sus propios comercios.
    function canManageOwnComercios() {
      return signedIn() && role() in ['COMERCIO', 'EDITOR', 'ADMIN'];
    }

    function isComercioOwner() {
      return signedIn()
        && resource.data.propietarioUid == request.auth.uid;
    }

    match /solicitudes_comercios/{solicitudId} {
      function requiredText(value, maxSize) {
        return value is string
          && value.trim().size() > 0
          && value.size() <= maxSize;
      }

      function validPhone(value) {
        return value is string
          && value.size() >= 7
          && value.size() <= 25
          && value.matches('[0-9+() .-]+')
          && value.replace('[^0-9]', '').size() >= 7
          && value.replace('[^0-9]', '').size() <= 15;
      }

      function validSolicitud() {
        return request.resource.data.keys().hasAll([
          'nombreNegocio', 'ciudad', 'cityId', 'categoria', 'direccion',
          'descripcion', 'telefono', 'whatsapp', 'horario',
          'nombreResponsable', 'correoResponsable', 'redesSociales',
          'estado', 'fechaSolicitud', 'userId'
        ])
        && request.resource.data.keys().hasOnly([
          'nombreNegocio', 'ciudad', 'cityId', 'categoria', 'direccion',
          'descripcion', 'telefono', 'whatsapp', 'horario',
          'nombreResponsable', 'correoResponsable', 'redesSociales',
          'estado', 'fechaSolicitud', 'userId'
        ])
        && requiredText(request.resource.data.nombreNegocio, 120)
        && requiredText(request.resource.data.ciudad, 80)
        && requiredText(request.resource.data.cityId, 80)
        && request.resource.data.cityId.matches('[a-z0-9_]+')
        && requiredText(request.resource.data.categoria, 80)
        && requiredText(request.resource.data.direccion, 240)
        && requiredText(request.resource.data.descripcion, 2000)
        && validPhone(request.resource.data.telefono)
        && validPhone(request.resource.data.whatsapp)
        && requiredText(request.resource.data.horario, 240)
        && requiredText(request.resource.data.nombreResponsable, 120)
        && request.resource.data.correoResponsable is string
        && request.resource.data.correoResponsable.size() <= 254
        && request.resource.data.correoResponsable.matches('[^@\\s]+@[^@\\s]+[.][^@\\s]+')
        && request.resource.data.redesSociales is string
        && request.resource.data.redesSociales.size() <= 500
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.userId is string
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.fechaSolicitud is timestamp
        && request.resource.data.fechaSolicitud == request.time;
      }

      allow create: if signedIn() && validSolicitud();
      allow read, update, delete: if false;
    }

    match /mail/{mailId} {
      allow read, write: if false;
    }

    match /usuarios/{uid} {
      allow get: if signedIn()
        && (request.auth.uid == uid || isAdmin() || isAuditor());

      allow list: if isAdmin() || isAuditor();

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.rol in ['USUARIO', 'COMERCIO'];

      allow update: if isAdmin()
        && request.auth.uid != uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.rol in ['ADMIN', 'USUARIO', 'EDITOR', 'COMERCIO', 'AUDITOR']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rol']);

      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.rol == resource.data.rol
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre']);

      allow delete: if false;
    }

    match /valoraciones/{valoracionId} {
      function validValoracion() {
        return signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.tipo in ['ciudad', 'lugar', 'comercio']
          && request.resource.data.estrellas is int
          && request.resource.data.estrellas >= 1
          && request.resource.data.estrellas <= 5
          && request.resource.data.keys().hasAll(['tipo', 'refId', 'uid', 'estrellas', 'actualizadoEn'])
          && request.resource.data.keys().hasOnly([
            'tipo', 'refId', 'cityId', 'uid', 'estrellas', 'comentario', 'actualizadoEn'
          ]);
      }

      allow read: if signedIn();
      allow create, update: if validValoracion();
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /ciudades/{cityId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    match /lugares/{monumentId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    match /comercios/{id} {
      // Público: aprobado y activo. El dueño ve los suyos aunque no lo estén.
      function isPublic() {
        return resource.data.get('aprobado', true) == true
          && resource.data.activo == true;
      }

      function ownsComercioDoc(data) {
        return data.propietarioUid == request.auth.uid;
      }

      allow read: if (signedIn() && isPublic())
        || (signedIn() && isComercioOwner())
        || isAdmin() || isAuditor();

      // Solo cuentas COMERCIO/EDITOR/ADMIN pueden crear comercios a su nombre.
      // Nacen sin aprobar y sin activar (pendientes de revisión).
      allow create: if canManageOwnComercios()
        && ownsComercioDoc(request.resource.data)
        && request.resource.data.aprobado == false
        && request.resource.data.activo == false;

      // El dueño edita su comercio pero no puede cambiar propietario ni aprobación.
      allow update: if isComercioOwner()
        && ownsComercioDoc(request.resource.data)
        && request.resource.data.aprobado == resource.data.aprobado;

      // Un ADMIN/EDITOR puede aprobar, activar o editar cualquier comercio.
      allow update: if isAdmin()
        || (signedIn()
            && role() == 'EDITOR'
            && request.resource.data.propietarioUid == resource.data.propietarioUid);

      allow delete: if isComercioOwner() || isAdmin();
    }
  }
}

