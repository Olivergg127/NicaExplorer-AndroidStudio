# Copia este archivo como .env y ajusta los valores.
# .env NUNCA debe versionarse (ya está en .gitignore).
#
# IMPORTANTE: usa el prefijo en minúsculas (`nica.`). CodeIgniter 4 resuelve
# las claves por el nombre corto de la clase en minúsculas; `Nica.` solo
# funciona en Windows por una particularidad de getenv() y falla en Linux.

CI_ENVIRONMENT = development

# Debe ser la URL con la que se abrirá el panel y que el móvil pueda alcanzar.
# Usa la IP LAN de tu PC (no localhost) para evitar errores de CORS.
app.baseURL = 'http://192.168.1.50:8080/'
app.indexPage = ''
app.forceGlobalSecureRequests = false

# Genera una con: php spark key:generate
encryption.key =

session.driver = 'CodeIgniter\Session\Handlers\FileHandler'

#-------------------------
# Firestore
#-------------------------
nica.projectId = nica-explore

# Vacío = Application Default Credentials (gcloud ADC).
# También puede apuntar a un JSON de cuenta de servicio (fuera de Git).
nica.credentialsFile =

# 'rest' si PHP no tiene la extensión grpc; 'grpc' si está instalada.
nica.firestoreTransport = rest

#-------------------------
# Imágenes
#-------------------------
# Prioridad: GitHub > Firebase Storage > modo local (public/uploads).

# Repositorio público de GitHub usado como almacén de imágenes.
# Ej.: Olivergg127/NicaExplorer-assets
nica.githubRepo =
# Token con permiso de escritura de contenido sobre el repo anterior.
nica.githubToken =
nica.githubBranch = main
nica.githubPath = uploads

# Bucket de Firebase Storage (requiere plan Blaze; opcional).
# Ej.: nica-explore.firebasestorage.app
nica.storageBucket =

# URL absoluta para las imágenes en modo local (debe ser alcanzable desde el móvil).
nica.publicBaseUrl = http://192.168.1.50:8080

#-------------------------
# Seguridad del backend
#-------------------------
# API REST: header X-API-KEY
nica.apiKey = cambia_esta_clave

# Panel web
nica.adminUser = admin
nica.adminPassword = cambia_esta_clave
