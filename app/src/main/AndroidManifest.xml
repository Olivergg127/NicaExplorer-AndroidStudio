<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- El AAR de MapLibre declara estos permisos de localización, pero en esta
         fase no se usa GPS. Se eliminan del manifest final para no declarar
         capacidad de ubicación sin necesidad (se habilitará en la fase GPS). -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION"
        tools:node="remove" />

    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
    </queries>

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".NicaExplorerApp"
        android:allowBackup="true"
        android:icon="@drawable/nicaexplorer_isotipo"
        android:label="NicaExplorer"
        android:roundIcon="@drawable/nicaexplorer_isotipo"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.NicaExplorer">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <activity
            android:name=".ui.screens.MapaActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name="com.unity3d.player.UnityPlayerActivity"
            android:exported="false"
            android:hardwareAccelerated="false"
            android:screenOrientation="fullUser"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            tools:replace="android:exported,android:screenOrientation,android:hardwareAccelerated,android:configChanges,android:launchMode,android:resizeableActivity">

            <intent-filter tools:node="remove">
                <category android:name="android.intent.category.LAUNCHER" />
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>

        </activity>

        <activity
            android:name=".ar.UnityArActivity"
            android:exported="false"
            android:hardwareAccelerated="false"
            android:screenOrientation="fullUser"
            android:theme="@style/UnityThemeSelector"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize"
            android:launchMode="singleTask"
            android:taskAffinity="com.lospuntoycoma.nicaexplorer.ar"
            android:excludeFromRecents="true"
            android:resizeableActivity="true">

        </activity>

    </application>

</manifest>
